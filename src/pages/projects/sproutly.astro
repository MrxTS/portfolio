---
import Layout from "../../layouts/Layout.astro";

const stackApp = [
  "iOS 17+",
  "SwiftUI",
  "@Observable",
  "async/await",
  "MVVM · Repository",
  "StoreKit 2",
  "Keychain",
];

const stackBackend = [
  "Supabase Postgres",
  "Row-Level Security",
  "Storage RLS",
  "Realtime",
  "Edge Functions (Deno)",
  "Claude Haiku 4.5",
];

const decisions = [
  {
    title: "Family by invitation, not by sharing",
    body:
      "Each invitation is a server-side token with a 7-day expiry. The accept-invitation Edge Function consumes it on first use and inserts the join row. No password sharing, no auth piggyback, no \"forward this to grandma\".",
  },
  {
    title: "Storage scoped to the family tree",
    body:
      "child-photos and milestone-photos buckets enforce RLS by extracting the first path segment as a uuid and checking is_child_parent. One folder per child, parentage-gated.",
  },
  {
    title: "Search-path-pinned SECURITY DEFINER",
    body:
      "Every helper function has set search_path = public, pg_temp. Without it, a temp-schema shadow object could redirect a SECURITY DEFINER call and bypass RLS. Subtle, but the kind of thing you only think about once you've read the Postgres advisories.",
  },
  {
    title: "Realtime over polling",
    body:
      "Supabase Realtime pushes log inserts to the other parent's app instantly. No \"pull-to-refresh\" theatre — the timeline updates while the partner types.",
  },
];

const whatsNext = [
  "Auth + onboarding + first-child setup",
  "Sleep / feeding / diaper logging UI",
  "Growth charts + milestone photos",
  "Partner invitation flow (email + deep link)",
  "Sleep prediction (Claude Haiku, on-demand)",
  "Paywall + 30-day trial + Supporter IAP",
];

const familyDiagram = `   Parent A creates child         ┌──────────────┐
   ───────────────────────────────▸│   children   │
                                   └──────┬───────┘
                                          │
                                          ▼
   Parent A is owner            ┌────────────────────┐
   ─────────────────────────────▸│   child_parents    │
                                 │   (join · roles)   │
                                 └────────────────────┘
                                          ▲
   Parent A invites partner               │
   ─▸ ┌─────────────┐                     │
      │ invitations │  token              │
      │  7-day TTL  │ ─────▸ accept ──────┘
      └─────────────┘   Edge Function
                       (consume + insert)

   Both parents see every log through is_child_parent()`;

const storageSnippet = `-- Photo paths are {child_id}/filename.ext.
-- Storage RLS extracts the first segment and
-- gates on parentage. No app-side checks needed.

create policy "child_photos_select"
  on storage.objects for select
  using (
    bucket_id = 'child-photos'
    and public.is_child_parent(
      (storage.foldername(name))[1]::uuid
    )
  );

create policy "child_photos_insert"
  on storage.objects for insert
  with check (
    bucket_id = 'child-photos'
    and public.is_child_parent(
      (storage.foldername(name))[1]::uuid
    )
  );`;

const helperSnippet = `-- The helper every policy depends on.
create or replace function
  public.is_child_parent(p_child_id uuid)
returns boolean
language sql
security definer
as $$
  select exists (
    select 1 from public.child_parents
    where child_id = p_child_id
      and user_id  = auth.uid()
  );
$$;

-- Defense against pg_temp schema-injection on
-- SECURITY DEFINER calls — without this pin a
-- crafted shadow object could subvert RLS.
alter function public.is_child_parent(uuid)
  set search_path = public, pg_temp;`;
---
<Layout
  title="Sproutly — Stefan Nguyen"
  description="An iOS baby tracker with shared timelines, storage-level RLS for photos, and a Claude-powered sleep predictor. Supabase backend live; iOS waiting on hardware."
  path="/projects/sproutly"
  ogImage="/og-sproutly.jpg"
>
  <main class="relative bg-black">
    <div class="bg-noise pointer-events-none absolute inset-0 opacity-[0.12]" />

    <div class="relative mx-auto max-w-5xl px-4 py-12 md:py-20">
      <a
        href="/#features"
        class="inline-flex items-center gap-2 text-xs text-primary/70 transition-colors hover:text-primary sm:text-sm"
      >
        ← back to portfolio
      </a>

      <header class="mt-12 md:mt-20">
        <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Project · 02</p>
        <h1 class="mt-4 text-4xl font-normal leading-[1.05] text-primary sm:text-5xl md:text-6xl lg:text-7xl">
          Sproutly.
        </h1>
        <p class="mt-6 max-w-2xl text-base text-gray-400 sm:text-lg md:text-xl">
          An iOS baby tracker for parents of newborns through preschoolers. Shared timelines,
          photo memories, and a <span class="font-serif italic text-primary/90">Sweet&nbsp;Spot</span>
          sleep predictor that learns from the last few weeks.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            Backend · live
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-amber-400/20 bg-amber-400/10 px-3 py-1 text-xs text-amber-300">
            <span class="h-1.5 w-1.5 rounded-full bg-amber-400" />
            iOS · in spec
          </span>
        </div>
      </header>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Stack</h2>
        <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="rounded-2xl bg-[#101010] p-5">
            <p class="text-[10px] uppercase tracking-[0.2em] text-amber-300/80">App · planned</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {stackApp.map((item) => (
                <span class="inline-flex items-center rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-primary/80">
                  {item}
                </span>
              ))}
            </div>
          </div>
          <div class="rounded-2xl bg-[#101010] p-5">
            <p class="text-[10px] uppercase tracking-[0.2em] text-emerald-300/80">Backend · live</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {stackBackend.map((item) => (
                <span class="inline-flex items-center rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-primary/80">
                  {item}
                </span>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">The shared timeline</h2>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{familyDiagram}</pre>
        </div>
        <p class="mt-6 max-w-3xl text-sm text-gray-400 md:text-base">
          A child has many parents — biological, step, grandparents who do night shifts. The
          schema models that as a join table with roles, and access flows through one helper
          function. Onboarding a partner is a token-based invitation that lives in the database
          for seven days; an Edge Function consumes it on first acceptance and writes the join
          row. No password sharing, no auth piggyback.
        </p>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Photos that know the family tree</h2>
        <p class="mt-4 max-w-3xl text-sm text-gray-400 md:text-base">
          Storage is the slipperiest part of multi-parent access — buckets are flat, not relational.
          Sproutly enforces parentage at the policy level by treating the first folder segment of
          every object path as the <code class="font-mono text-primary/80">child_id</code>, then
          gating on the same helper that protects every other table.
        </p>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{storageSnippet}</pre>
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">One helper, hardened</h2>
        <p class="mt-4 max-w-3xl text-sm text-gray-400 md:text-base">
          Every RLS policy in the app — children, all six log types, milestones, storage — calls
          <code class="font-mono text-primary/80"> is_child_parent</code>. That makes it the
          highest-leverage function in the schema, which also makes it the highest-value attack
          surface. So it gets a pin: <code class="font-mono text-primary/80">set search_path = public, pg_temp</code>.
          Without that line, a malicious temp-schema object could shadow a public reference and
          subvert the SECURITY DEFINER context. Cheap defense, real impact.
        </p>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{helperSnippet}</pre>
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Decisions worth defending</h2>
        <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
          {decisions.map((d) => (
            <div class="rounded-2xl bg-[#101010] p-6">
              <h3 class="text-base font-medium text-primary md:text-lg">{d.title}</h3>
              <p class="mt-3 text-sm text-gray-400 md:text-[15px]">{d.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">What's next</h2>
        <p class="mt-4 max-w-3xl text-sm text-gray-400 md:text-base">
          Plan B (iOS Core) ships the day a Mac arrives. The feature list below is what the
          first TestFlight build covers:
        </p>
        <ul class="mt-6 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {whatsNext.map((item) => (
            <li class="flex items-start gap-3 rounded-xl bg-[#101010] px-4 py-3">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400" />
              <span class="text-sm text-gray-300">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-20 md:mt-28">
        <div class="rounded-2xl bg-[#101010] px-6 py-12 text-center md:px-12 md:py-16">
          <h2 class="text-2xl font-normal text-primary sm:text-3xl md:text-4xl leading-[1.05]">
            Want the <span class="font-serif italic">backend</span> source?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-sm text-gray-400 md:text-base">
            Schema, RLS, storage policies, the invitation Edge Function — happy to walk through.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="mailto:stng.dev@proton.me?subject=Sproutly%20%E2%80%94%20code%20request"
              class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2 text-sm font-medium text-black transition-opacity hover:opacity-90"
            >
              Request walkthrough
            </a>
            <a
              href="/#features"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2 text-sm text-primary/80 transition-colors hover:border-white/40 hover:text-primary"
            >
              ← back to portfolio
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
