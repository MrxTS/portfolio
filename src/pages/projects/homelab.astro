---
import Layout from "../../layouts/Layout.astro";

const stack = [
  { label: "Hypervisor", items: ["Proxmox VE 9", "2 nodes · 32 LXCs"] },
  { label: "Edge", items: ["Traefik v3", "CrowdSec (bouncer plugin)", "Let's Encrypt (DNS-01)", "Cloudflare DDNS"] },
  { label: "Identity", items: ["Authentik (SSO · OIDC · ForwardAuth)"] },
  { label: "Storage & Backup", items: ["Synology DSM", "Proxmox Backup Server (2 datastores)", "Backrest / restic"] },
  { label: "Monitoring", items: ["Telegraf", "InfluxDB", "Grafana", "Uptime-Kuma v2", "Gatus", "Beszel", "Scrutiny", "ntfy"] },
  { label: "Apps", items: ["Vaultwarden", "n8n", "Paperless-ngx", "Home Assistant", "Forgejo", "Karakeep", "Navidrome", "Audiobookshelf", "CouchDB LiveSync", "Stirling-PDF"] },
  { label: "DNS & Networking", items: ["Technitium (3-node HA)", "keepalived (vIP failover)", "NetBird (self-hosted mesh)"] },
  { label: "Ops", items: ["Docker Compose", "Git-tracked configs", "Diun (image updates)", "Weekly automated audit"] },
];

const highlights = [
  {
    title: "LXC over VMs",
    body:
      "32 lightweight containers across two Proxmox nodes. Memory headroom over isolation cost — it works because every workload is mine.",
  },
  {
    title: "Single sign-on by default",
    body:
      "Every web service sits behind Traefik → Authentik. One login, forwarded auth headers, no app-side user tables to maintain.",
  },
  {
    title: "DNS that survives the host",
    body:
      "Technitium runs on three machines — Mini-PC, Raspberry Pi, ThinkPad node — with zone transfer from a single master. keepalived hands one virtual IP down the priority chain, so name resolution outlives any single box.",
  },
  {
    title: "Backups I actually trust",
    body:
      "Proxmox Backup Server keeps a hot datastore on NVMe and syncs deduplicated to a cold one on the Synology; Backrest adds file-level restic snapshots. Restore drills run monthly — scheduled backups without a tested restore are a rumour.",
  },
  {
    title: "Second node, not a bigger one",
    body:
      "An old ThinkPad became the second Proxmox node. Same-VMID, same-IP container moves meant zero reverse-proxy changes, and the RAM pressure on the Mini-PC disappeared.",
  },
  {
    title: "Mesh instead of a VPN box",
    body:
      "Self-hosted NetBird replaced the WireGuard tunnel. Peers talk directly, auth goes through Authentik via OIDC, and remote access no longer depends on one port-forward staying open.",
  },
];

const architecture = `                      Internet
                         │
                    ┌────▼─────┐
                    │ Traefik  │ ← TLS (DNS-01) · CrowdSec · Authentik
                    └────┬─────┘
        ┌────────────────┴────────────────┐
        ▼                                 ▼
┌──────────────────┐              ┌──────────────────┐
│   MS-01          │              │   P52s ThinkPad  │
│   Proxmox 9      │              │   Proxmox 9      │
│   18 LXCs        │              │   14 LXCs        │
│                  │              │                  │
│ traefik · authen-│              │ forgejo · arr    │
│ tik · vaultwarden│              │ paperless · nav- │
│ n8n · netbird ·  │              │ idrome · audio-  │
│ observability    │              │ bookshelf · sure │
└───┬──────────┬───┘              └────────┬─────────┘
    │          │                           │
    │ PBS sync │                           │
    ▼          │                           │
┌──────────┐   │                           │
│ Synology │   │                           │
│  DS224+  │   │                           │
│ NFS·cold │   │                           │
└──────────┘   │                           │
               │   Technitium DNS · zone transfer
               ├───────────────┬───────────┘
               ▼               ▼
      ┌────────────────┐  ┌──────────────┐
      │ Raspberry Pi 4 │  │ tech3 (P52s) │
      │  DNS secondary │  │ DNS tertiary │
      └────────────────┘  └──────────────┘
               keepalived vIP · 110 → 90 → 80

     NetBird mesh overlays all four hosts + mobile peers`;

const traefikSnippet = `# Services live in their own LXCs, so routing is file-provider,
# not container labels. Same three-step chain for every host.
http:
  routers:
    it-tools:
      rule: "Host(\`tools.stng.dev\`)"
      entryPoints: [websecure]
      service: it-tools
      tls:
        certResolver: cloudflare      # wildcard via DNS-01
        domains:
          - main: stng.dev
            sans: ["*.stng.dev"]
      middlewares:
        - secure-headers@file
        - internal-only@file          # LAN + mesh only
        - authentik@file              # ForwardAuth → SSO
  services:
    it-tools:
      loadBalancer:
        servers:
          - url: "http://192.168.178.160:8080"`;

---
<Layout
  title="Homelab — Stefan Nguyen"
  description="Self-hosted production stack on a two-node Proxmox cluster: reverse proxy, SSO, HA DNS, monitoring, tested backups. The infrastructure I run my own services on."
  path="/projects/homelab"
  ogImage="/og-homelab.jpg"
>
  <main class="relative bg-black">
    <div class="bg-noise pointer-events-none absolute inset-0 opacity-[0.12]" />

    <div class="relative mx-auto max-w-5xl px-4 py-12 md:py-20">
      <a
        href="/#features"
        class="inline-flex items-center gap-2 text-xs text-primary/70 transition-colors hover:text-primary sm:text-sm"
      >
        ← back to portfolio
      </a>

      <header class="mt-12 md:mt-20">
        <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Project · 03</p>
        <h1 class="mt-4 text-4xl font-normal leading-[1.05] text-primary sm:text-5xl md:text-6xl lg:text-7xl">
          Homelab.
        </h1>
        <p class="mt-6 max-w-2xl text-base text-gray-400 sm:text-lg md:text-xl">
          A self-hosted production stack on a two-node Proxmox cluster. Reverse proxy, single
          sign-on, highly available DNS, monitoring, tested backups — running 24/7 with zero
          external dependencies for the things I depend on.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            Live
          </span>
          <span class="inline-flex items-center rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-primary/70">
            MS-01 · P52s · Pi 4 · DS224+
          </span>
        </div>
      </header>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Stack</h2>
        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {stack.map((group) => (
            <div class="rounded-2xl bg-[#101010] p-5">
              <p class="text-[10px] uppercase tracking-[0.2em] text-primary/70">
                {group.label}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="inline-flex items-center rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-primary/80">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Architecture</h2>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{architecture}</pre>
        </div>
        <p class="mt-6 max-w-3xl text-sm text-gray-400 md:text-base">
          One ingress point, one identity layer, one monitoring stack. Every web service routes
          through Traefik with a Let's Encrypt wildcard (DNS-01) and a CrowdSec bouncer, then
          through Authentik for SSO. Workloads are split across two Proxmox nodes — a Mini-PC and
          a repurposed ThinkPad — so the memory-hungry stacks stopped competing with each other.
          Internal DNS is a three-node Technitium setup: one master, two secondaries fed by zone
          transfer, one virtual IP handed down a keepalived priority chain. Remote access is a
          self-hosted NetBird mesh that overlays all four machines; backups run block-level to a
          hot NVMe datastore and sync deduplicated to the Synology overnight.
        </p>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Decisions worth defending</h2>
        <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
          {highlights.map((h) => (
            <div class="rounded-2xl bg-[#101010] p-6">
              <h3 class="text-base font-medium text-primary md:text-lg">{h.title}</h3>
              <p class="mt-3 text-sm text-gray-400 md:text-[15px]">{h.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Code excerpt</h2>
        <p class="mt-4 max-w-2xl text-sm text-gray-400 md:text-base">
          One router file per service in <code class="font-mono text-primary/80">traefik/config/</code>.
          Wildcard cert, network scope, SSO — the same three middlewares on every host.
        </p>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{traefikSnippet}</pre>
        </div>
      </section>

      <section class="mt-20 md:mt-28">
        <div class="rounded-2xl bg-[#101010] px-6 py-12 text-center md:px-12 md:py-16">
          <h2 class="text-2xl font-normal text-primary sm:text-3xl md:text-4xl leading-[1.05]">
            Want the <span class="font-serif italic">full</span> topology?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-sm text-gray-400 md:text-base">
            Container inventory, Compose files, network ranges — happy to walk through it.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="mailto:stng.dev@proton.me?subject=Homelab%20%E2%80%94%20walkthrough"
              class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2 text-sm font-medium text-black transition-opacity hover:opacity-90"
            >
              Request walkthrough
            </a>
            <a
              href="/#features"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2 text-sm text-primary/80 transition-colors hover:border-white/40 hover:text-primary"
            >
              ← back to portfolio
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
