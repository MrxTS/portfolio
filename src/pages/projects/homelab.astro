---
import Layout from "../../layouts/Layout.astro";

const stack = [
  { label: "Hypervisor", items: ["Proxmox VE 9"] },
  { label: "Edge", items: ["Traefik", "CrowdSec", "Let's Encrypt"] },
  { label: "Identity", items: ["Authentik (SSO)"] },
  { label: "Storage & Backup", items: ["Synology DSM", "Backrest (file-level)", "Proxmox Backup Server"] },
  { label: "Monitoring", items: ["Telegraf", "InfluxDB", "Grafana", "Uptime-Kuma", "Gatus", "Scrutiny"] },
  { label: "Apps", items: ["Vaultwarden", "n8n", "Paperless-ngx", "Home Assistant"] },
  { label: "DNS & Networking", items: ["Technitium", "keepalived (vIP failover)", "WireGuard (VPN)"] },
  { label: "Hardware / IoT", items: ["Plant Monitor (ADS1115 · I²C)", "Python + systemd"] },
];

const highlights = [
  {
    title: "LXC over VMs",
    body:
      "21 lightweight containers on a single Mini-PC. Memory headroom over isolation cost — works because every workload is mine.",
  },
  {
    title: "Single sign-on by default",
    body:
      "Every web service sits behind Traefik → Authentik. One login, forwarded auth headers, no app-side user tables to maintain.",
  },
  {
    title: "DNS that survives the host",
    body:
      "Technitium runs on the Mini-PC and on a Raspberry Pi. keepalived hands a virtual IP between them — if the primary dies, name resolution keeps working long enough to fix it.",
  },
  {
    title: "Backups I actually trust",
    body:
      "Two layers: Backrest takes file-level snapshots to the Synology, Proxmox Backup Server handles block-level CT/VM snapshots. Restore-tested, not just scheduled.",
  },
];

const architecture = `        Internet
           │
       ┌───▼───────┐
       │  Traefik  │  ← TLS · CrowdSec WAF
       └───┬───────┘
           │
   ┌───────┼────────────┐
   ▼       ▼            ▼
┌─────────┐ ┌──────┐ ┌──────────────┐
│Authentik│ │ Apps │ │ Home Assistant│
│  (SSO)  │ │      │ │               │
└─────────┘ └──────┘ └──────────────┘

┌──────────────┐    ┌──────────────┐
│   MS-01      │───▸│  Synology    │
│ Proxmox · 21 │    │  DS224+      │
│    LXCs      │    │  (backup)    │
└──────┬───────┘    └──────────────┘
       │
       │ keepalived vIP
       ▼
┌──────────────┐
│ Raspberry Pi │
│  Technitium  │
│  keepalived  │
│  WireGuard   │
│  Plant Mon.  │
└──────┬───────┘
       │
       │ I²C soil-moisture
       ▼
   ADS1115 sensor → InfluxDB (plant_monitoring)`;

const traefikSnippet = `# Every app gets the same chain: TLS → SSO → WAF
labels:
  - traefik.enable=true
  - traefik.http.routers.app.rule=Host(\`app.example.dev\`)
  - traefik.http.routers.app.entrypoints=websecure
  - traefik.http.routers.app.tls.certresolver=letsencrypt
  - traefik.http.routers.app.middlewares=authentik@file,crowdsec@file`;
---
<Layout
  title="Homelab — Stefan Nguyen"
  description="Self-hosted production stack on a Mini-PC: reverse proxy, SSO, monitoring, backups. The infrastructure I run my own services on."
  path="/projects/homelab"
  ogImage="/og-homelab.jpg"
>
  <main class="relative bg-black">
    <div class="bg-noise pointer-events-none absolute inset-0 opacity-[0.12]" />

    <div class="relative mx-auto max-w-5xl px-4 py-12 md:py-20">
      <a
        href="/#features"
        class="inline-flex items-center gap-2 text-xs text-primary/70 transition-colors hover:text-primary sm:text-sm"
      >
        ← back to portfolio
      </a>

      <header class="mt-12 md:mt-20">
        <p class="text-xs uppercase tracking-[0.2em] text-gray-500">Project · 03</p>
        <h1 class="mt-4 text-4xl font-normal leading-[1.05] text-primary sm:text-5xl md:text-6xl lg:text-7xl">
          Homelab.
        </h1>
        <p class="mt-6 max-w-2xl text-base text-gray-400 sm:text-lg md:text-xl">
          A self-hosted production stack on a single Mini-PC. Reverse proxy, single sign-on,
          monitoring, backups — running 24/7 with zero external dependencies for the
          things I depend on.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="inline-flex items-center gap-2 rounded-full border border-emerald-400/20 bg-emerald-400/10 px-3 py-1 text-xs text-emerald-300">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-400" />
            Live
          </span>
          <span class="inline-flex items-center rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-primary/70">
            MS-01 · Pi 4 · DS224+
          </span>
        </div>
      </header>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Stack</h2>
        <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
          {stack.map((group) => (
            <div class="rounded-2xl bg-[#101010] p-5">
              <p class="text-[10px] uppercase tracking-[0.2em] text-primary/70">
                {group.label}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <span class="inline-flex items-center rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-primary/80">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Architecture</h2>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{architecture}</pre>
        </div>
        <p class="mt-6 max-w-3xl text-sm text-gray-400 md:text-base">
          One ingress point, one identity layer, one monitoring stack. Every web service routes
          through Traefik with Let's Encrypt + CrowdSec, then through Authentik for SSO. Internal
          DNS lives on a primary node and a Raspberry Pi backup with a shared virtual IP — if the
          Mini-PC reboots, resolution doesn't. Remote access is a WireGuard tunnel into the Pi;
          a soil-moisture sensor on the same Pi feeds time-series data into the InfluxDB on
          MS-01 — small reminder that the lab is also hardware.
        </p>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Decisions worth defending</h2>
        <div class="mt-6 grid grid-cols-1 gap-3 md:grid-cols-2">
          {highlights.map((h) => (
            <div class="rounded-2xl bg-[#101010] p-6">
              <h3 class="text-base font-medium text-primary md:text-lg">{h.title}</h3>
              <p class="mt-3 text-sm text-gray-400 md:text-[15px]">{h.body}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mt-16 md:mt-24">
        <h2 class="text-xs uppercase tracking-[0.2em] text-gray-500">Code excerpt</h2>
        <p class="mt-4 max-w-2xl text-sm text-gray-400 md:text-base">
          The shape of every container's <code class="font-mono text-primary/80">docker-compose.yml</code>.
          One label-block, three middlewares, full chain.
        </p>
        <div class="mt-6 overflow-x-auto rounded-2xl bg-[#0a0a0a] p-5 md:p-7">
          <pre class="font-mono text-[11px] leading-relaxed text-primary/80 sm:text-xs md:text-sm">{traefikSnippet}</pre>
        </div>
      </section>

      <section class="mt-20 md:mt-28">
        <div class="rounded-2xl bg-[#101010] px-6 py-12 text-center md:px-12 md:py-16">
          <h2 class="text-2xl font-normal text-primary sm:text-3xl md:text-4xl leading-[1.05]">
            Want the <span class="font-serif italic">full</span> topology?
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-sm text-gray-400 md:text-base">
            Container inventory, Compose files, network ranges — happy to walk through it.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a
              href="mailto:stng.dev@proton.me?subject=Homelab%20%E2%80%94%20walkthrough"
              class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2 text-sm font-medium text-black transition-opacity hover:opacity-90"
            >
              Request walkthrough
            </a>
            <a
              href="/#features"
              class="inline-flex items-center gap-2 rounded-full border border-white/15 px-5 py-2 text-sm text-primary/80 transition-colors hover:border-white/40 hover:text-primary"
            >
              ← back to portfolio
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>
</Layout>
