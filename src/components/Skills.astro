---
interface Category {
  label: string;
  skills: string[];
}

const categories: Category[] = [
  {
    label: "Testing",
    skills: ["k6", "Postman", "Appium", "GitLab CI"],
  },
  {
    label: "Development",
    skills: ["Swift", "SwiftUI", "Supabase", "Java"],
  },
  {
    label: "Infrastructure & Observability",
    skills: ["Docker", "OpenShift", "Kibana", "Elasticsearch", "Linux", "Grafana"],
  },
];
---
<section id="skills" class="bg-black px-4 py-20 md:py-28">
  <div class="mx-auto max-w-6xl">
    <span class="text-[10px] uppercase tracking-[0.2em] text-primary sm:text-xs">
      Stack
    </span>
    <h2 class="mt-4 max-w-3xl text-3xl font-normal text-primary sm:text-4xl md:text-5xl leading-[0.95]">
      Tools, frameworks, and the systems<span class="text-gray-500"> that hold them together.</span>
    </h2>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-3">
      {categories.map((cat) => (
        <div class="rounded-2xl bg-[#101010] p-6">
          <span class="text-[10px] uppercase tracking-[0.2em] text-primary/70 sm:text-xs">
            {cat.label}
          </span>
          <div class="mt-4 flex flex-wrap gap-2">
            {cat.skills.map((skill) => (
              <span class="rounded-full border border-white/10 bg-[#212121] px-3 py-1 text-xs text-gray-300 sm:text-sm">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
