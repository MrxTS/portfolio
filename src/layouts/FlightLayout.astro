---
/**
 * Eigenes Layout für die Startseite.
 *
 * Bewusst NICHT `Layout.astro`: das zieht `global.css` mit Tailwind, die
 * Almarai-Schrift und Body-Klassen herein, die der Flug alle nicht braucht.
 * Die Projektseiten laufen unverändert weiter über `Layout.astro`.
 */
import type { FlightCopy } from "../content/flight";

interface Props {
  copy: FlightCopy;
  path: string;
}
const { copy, path } = Astro.props;

const siteUrl = "https://portfolio.stng.dev";
const pageUrl = `${siteUrl}${path}`;
const ogImage = `${siteUrl}/og-image.jpg`;
const isRoot = path === "/";
---
<!DOCTYPE html>
<!-- data-sc-lerp gehört auf das Dokumentelement, nicht auf die Mode-Wurzel:
     die Engine liest die Mount-Wurzel (hier `document`, also kein Element) und
     danach <html>. 0,12 statt der 0,18-Vorgabe, weil ein Flug mehr Beine und
     mehr Nähte gleichzeitig montiert hat. -->
<html lang={copy.htmlLang} data-sc-lerp="0.12">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={copy.meta.description} />
    <title>{copy.meta.title}</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="de" href={`${siteUrl}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}/`} />

    {/* Die beiden Schnitte, die über der Falz gebraucht werden. Der Rest der
        Familie kommt per font-display: swap nach. */}
    <link rel="preload" href="/fonts/ibm-plex-sans-600-2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-400-2.woff2" as="font" type="font/woff2" crossorigin />

    {/* Das erste Poster entscheidet, wie schnell die Seite etwas zeigt. */}
    <link rel="preload" href="/flight/p01.webp" as="image" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={copy.htmlLang === "de" ? "de_DE" : "en_GB"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={pageUrl} />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    {isRoot && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Stefan Nguyen",
        url: siteUrl,
        image: ogImage,
        jobTitle: "Software Test Engineer & iOS Developer",
        description: copy.meta.description,
        sameAs: [
          "https://github.com/MrxTS",
          "https://www.linkedin.com/in/stefan-nguyen-025776135/",
        ],
      })} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
